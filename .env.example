# ---------------------------------------------------------------------------
# 3D Surgical Manufacturing Management — environment
#
# Copy to .env and fill in. Never commit .env; it holds the key that decrypts
# platform service-account passwords and patient identifiers.
# ---------------------------------------------------------------------------

NODE_ENV=development

# PostgreSQL. For development, `npm run db:start` runs one on this machine with
# exactly these settings — nothing to install. In production, point this at a
# real PostgreSQL server instead.
DATABASE_URL="postgresql://mms:mms@localhost:5433/mms?schema=public"

# The domain the application is served under — a hostname only, no scheme or
# port. The admin console is at admin.<BASE_DOMAIN> and each company space at
# <space-id>.<BASE_DOMAIN>, so production needs a wildcard DNS record and
# certificate for it. "localhost" works as-is for development: browsers resolve
# every *.localhost name to this machine.
BASE_DOMAIN="localhost"

# Where uploaded documents, reports and photos are kept. In production, put
# this on persistent storage and include it in backups.
STORAGE_DIR=".storage"

# --- Secrets ---------------------------------------------------------------
# Generate each of these fresh per environment. Rotating ENCRYPTION_KEY
# invalidates every stored platform credential and patient identifier, and
# signs everyone out.
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"  -> ENCRYPTION_KEY
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"     -> SESSION_SECRET
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"     -> CRON_SECRET
ENCRYPTION_KEY=""
SESSION_SECRET=""
CRON_SECRET=""

# --- First super admin ------------------------------------------------------
# Read only by `npm run db:seed`, which creates this account if it does not
# exist. Super admins sign in at the admin console (admin.<BASE_DOMAIN>);
# everyone else signs in at their own company space's address.
SUPER_ADMIN_EMAIL=""
SUPER_ADMIN_PASSWORD=""
SUPER_ADMIN_NAME="Platform Admin"

# --- Session policy --------------------------------------------------------
# Idle timeout, and the hard ceiling a session can never outlive.
SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_HOURS=12

# --- Login throttling ------------------------------------------------------
# Failed attempts allowed per email inside the window (the per-IP allowance is
# four times this, since an office shares one address).
LOGIN_MAX_ATTEMPTS=8
LOGIN_WINDOW_MINUTES=15
